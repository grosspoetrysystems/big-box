#!/bin/sh
# Symlink every skill in this checkout into an agent skills directory (default ~/.agents/skills).
# Refuses to replace a real directory: an existing copy may hold local edits.
set -eu

root=$(cd "$(dirname "$0")/.." && pwd)
target=${1:-"$HOME/.agents/skills"}
mkdir -p "$target"

for skill in "$root"/skills/*/; do
  name=$(basename "$skill")
  dest="$target/$name"
  if [ -e "$dest" ] && [ ! -L "$dest" ]; then
    echo "skipped $name: $dest is a real directory; move it aside first" >&2
    continue
  fi
  ln -sfn "${skill%/}" "$dest"
  echo "linked $dest -> ${skill%/}"
done
